# Environment variables for local development
# HTTP port for health checks. Render sets this itself. Defaults to 3000
PORT=
SERVICE_HOST=

# Redis that web-api and user-service talk through.
# On Render, set REDIS_URL to the Key Value internal URL (redis://red-xxxx:6379).
# Locally, leave it empty and use REDIS_HOST/REDIS_PORT (default localhost:6379).
REDIS_URL=
REDIS_HOST=
REDIS_PORT=

MONGODB_URI=
